# LogSentinel Environment Configuration
# Copy this file to .env and fill in your values

# ==========================================
# AI Provider Configuration
# ==========================================
# Options: openai, claude, gemini, ollama, smart_guess
AI_PROVIDER=smart_guess

# OpenAI API Key (for GPT-4)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key (for Claude)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google API Key (for Gemini)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Ollama URL (for local LLM - FREE)
OLLAMA_URL=http://localhost:11434

# ==========================================
# IP Blocking Configuration
# ==========================================
# Options: local, iptables, ufw, cloudflare, webhook
IP_BLOCKER_BACKEND=local

# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Webhook URL for custom blocking
BLOCK_WEBHOOK_URL=

# ==========================================
# Database Configuration
# ==========================================
# SQLite is used by default
# For PostgreSQL, uncomment below:
# DATABASE_URL=postgresql://user:password@localhost/logsentinel
